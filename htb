#       :+**=      =**+:
#    =%@*-            -*@%=
#   #@@@*-            -*@@@#  ██╗  ██╗████████╗██████╗
#   #*- -#%%*.    .*%%#- -*#  ██║  ██║╚══██╔══╝██╔══██╗
#   #+.     :*####*:     .+#  ███████║   ██║   ██████╔╝
#   #+.       :@@:       .+#  ██╔══██║   ██║   ██╔══██╗
#   #+.       :@@:       .+#  ██║  ██║   ██║   ██████╔╝
#   ##+       :@@:       +##  ╚═╝  ╚═╝   ╚═╝   ╚═════╝
#     -+*+:   :@@:   :+*+-
#         =#%#%@@%#%#=
#            .=**=.
#
#	Author	    -	C4sh$R
#   Modified    -   Ch4rum
#	Repo	    -	https://github.com/C4sh3R/htb-cli
#
#   htb - HackTheBox terminal client (current API v4)
#   Designed for first blood: fast spawning, instant IP retrieval, and flag submission.
#
#   Token: read from $HTB_TOKEN or, alternatively, from ~/.config/htb/token
#   Requirements: curl, jq, python3 (only for occasional parsing)
#
#   Appearance:
#       HTB_ICONS=nerd|emoji|ascii   force the icon set (auto-detected by default)
#       NO_COLOR=1                  disable colors

set -o pipefail

HTB_VERSION="1.5.3"

# ================= Appearance =================
#
# Auto-detect the icon set to ensure proper rendering in any terminal:
#   nerd  -> a Nerd Font is installed
#   emoji -> UTF-8 terminal without a Nerd Font
#   ascii -> no UTF-8 support, or output redirected to a file/pipe

if [ -t 1 ]; then IS_TTY=1; else IS_TTY=0; fi

detect_icons() {
    if [ -n "$HTB_ICONS" ]; then printf '%s' "$HTB_ICONS"; return; fi
    [ "$IS_TTY" = 1 ] || { printf 'ascii'; return; }
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *UTF-8*|*utf-8*|*UTF8*|*utf8*) ;;
        *) printf 'ascii'; return ;;
    esac
    local nf=0
    if command -v fc-list >/dev/null 2>&1; then
        nf=$(fc-list 2>/dev/null | grep -ci 'nerd font') || nf=0
    fi
    if [ "${nf:-0}" -gt 0 ] 2>/dev/null; then printf 'nerd'; return; fi
    
    printf 'emoji'
}
ICONSET="$(detect_icons)"
SELF_ID=""

if [ "$IS_TTY" = 1 ] && [ -z "$NO_COLOR" ]; then
    RST=$'\e[0m';        BOLD=$'\e[1m';        DIM=$'\e[2m'
    RED=$'\e[38;5;203m'; GRN=$'\e[38;5;114m';  YEL=$'\e[38;5;221m'
    BLU=$'\e[38;5;75m';  MAG=$'\e[38;5;176m';  CYN=$'\e[38;5;80m'
    ORG=$'\e[38;5;215m'; GRY=$'\e[38;5;244m';  WHT=$'\e[38;5;255m'
else
    RST= BOLD= DIM= RED= GRN= YEL= BLU= MAG= CYN= ORG= GRY= WHT=
fi
# Compatibility alias for the legacy code
g="$GRN$BOLD"; r="$RED$BOLD"; b="$BLU$BOLD"; y="$YEL$BOLD"; c="$CYN$BOLD"; e="$RST"

case "$ICONSET" in
  emoji)
    I_WIN='🪟' I_LNX='🐧' I_BSD='😈' I_MAC='🍎' I_OTH='💻'
    I_OK='✅' I_NO='❌' I_BLOOD='🩸' I_DOT='●' I_FLAG='🚩' I_NONE='·'
    I_OWN='🟩' I_NOOWN='⬜'
    I_USER='👤' I_ROOT='👑' I_NET='🌐' I_KEY='🔑' I_CLOCK='🕒' I_BOX='📦'
    I_UP='🚀' I_WARN='🚨' I_INFO='📌' I_LOCK='🔒' I_STAR='⭐' I_TGT='🎯' ;;
  ascii)
    I_WIN='WIN' I_LNX='LNX' I_BSD='BSD' I_MAC='MAC' I_OTH=' ? '
    I_OK='[+]' I_NO='[-]' I_BLOOD='<*>' I_DOT='o' I_FLAG='>>' I_NONE=' . '
    I_OWN='[x]' I_NOOWN='[ ]'
    I_USER='U' I_ROOT='R' I_NET='@' I_KEY='K' I_CLOCK='T' I_BOX='#'
    I_UP='>' I_WARN='!' I_INFO='i' I_LOCK='L' I_STAR='*' I_TGT='x' ;;
  *)
    I_WIN=$'' I_LNX=$'' I_BSD=$'' I_MAC=$'' I_OTH=$''
    I_OK=$''  I_NO=$''  I_BLOOD=$'' I_DOT=$'●'
    I_OWN=$'' I_NOOWN=$''
    I_FLAG=$'' I_NONE=$'·'
    I_USER=$'' I_ROOT=$'' I_NET=$'' I_KEY=$''
    I_CLOCK=$'' I_BOX=$'' I_UP=$'' I_WARN=$''
    I_INFO=$'' I_LOCK=$'' I_STAR=$'' I_TGT=$'' ;;
esac

_banner() {
    # Modern gradient palette (true-color). Falls back to empty strings w/ --no-color.
    local g1 g2 g3 g4 g5 g6 b1 b2 acc box
    text="$1"
    if [[ -n "$RST" ]]; then
        g1=$'\e[38;2;0;255;200m';   g2=$'\e[38;2;0;225;235m'   # teal → cyan
        g3=$'\e[38;2;60;180;255m';  g4=$'\e[38;2;130;120;255m' # blue → indigo
        g5=$'\e[38;2;190;90;255m';  g6=$'\e[38;2;255;70;200m'  # violet → magenta
        b1=$'\e[38;2;255;60;120m';  b2=$'\e[38;2;255;180;60m'  # pink / amber accents
        acc=$'\e[38;2;0;255;160m';  box=$'\e[38;2;90;100;120m'
    fi
cat <<EOF

${GRN}${BOLD}          .+#%%#+.
${GRN}${BOLD}      :+**=      =**+:
${GRN}${BOLD}   =%@*-            -*@%=
${GRN}${BOLD}  #@@@*-            -*@@@#  ${g1}${BOLD}██╗  ██╗${g4}████████╗██████╗${RST}
${GRN}${BOLD}  #*- -#%%*.    .*%%#- -*#  ${g1}${BOLD}██║  ██║${g4}╚══██╔══╝██╔══██╗${RST}
${GRN}${BOLD}  #+.     :*####*:     .+#  ${g2}${BOLD}███████║${g5}   ██║   ██████╔╝${RST}
${GRN}${BOLD}  #+.       :@@:       .+#  ${g2}${BOLD}██╔══██║${g5}   ██║   ██╔══██╗${RST}
${GRN}${BOLD}  #+.       :@@:       .+#  ${g3}${BOLD}██║  ██║${g6}   ██║   ██████╔╝${RST}
${GRN}${BOLD}  ##+       :@@:       +##  ${g3}${BOLD}╚═╝  ╚═╝${g6}   ╚═╝   ╚═════╝${RST}
${GRN}${BOLD}    -+*+:   :@@:   :+*+-
${GRN}${BOLD}        =#%#%@@%#%#=
${GRN}${BOLD}           .=**=.
EOF
}

# ---- Actual visible width (skips ANSI codes, counts emoji as 2 columns) ----
_vlen() {
    local s="$1"
    local n=${#s} i=0 ch cp w=0 esc=0
    while (( i < n )); do
        ch="${s:i:1}"
        if (( esc )); then
            [[ $ch == [a-zA-Z] ]] && esc=0
            (( i++ )); continue
        fi
        if [[ $ch == $'\e' ]]; then esc=1; (( i++ )); continue; fi
        printf -v cp '%d' "'$ch" 2>/dev/null || cp=63
        if   (( cp >= 0x0300 && cp <= 0x036F )); then :
        elif (( (cp >= 0x1100  && cp <= 0x115F) || \
                (cp >= 0x2700  && cp <= 0x27BF) || \
                (cp >= 0x2B00  && cp <= 0x2BFF) || \
                (cp >= 0x2E80  && cp <= 0xA4CF) || \
                (cp >= 0xAC00  && cp <= 0xD7A3) || \
                (cp >= 0xF900  && cp <= 0xFAFF) || \
                (cp >= 0xFE30  && cp <= 0xFE6F) || \
                (cp >= 0xFF00  && cp <= 0xFF60) || \
                (cp >= 0x1F000 && cp <= 0x1FAFF) )); then w=$(( w + 2 ))
        else w=$(( w + 1 )); fi
        (( i++ ))
    done
    printf '%s' "$w"
}
# cell: prints <text> + padding up to <width> (printf generates the padding,
# so command substitution cannot strip it)
cell() { local n; n=$(( $2 - $(_vlen "$1") )); (( n < 0 )) && n=0; printf '%s%*s' "$1" "$n" ''; }
pad()  { local t="$1" w="$2" al="${3:-left}" l n sp
         l=$(_vlen "$t"); n=$(( w - l )); (( n < 0 )) && n=0
         printf -v sp '%*s' "$n" ''
         if [ "$al" = right ]; then printf '%s%s' "$sp" "$t"; else printf '%s%s' "$t" "$sp"; fi; }
line() { local s; printf -v s '%*s' "$1" ''; printf '%s' "${s// /─}"; }

title() { local t="$1" w="${2:-74}"
          printf '%s╭%s╮%s\n' "$CYN" "$(line $((w-2)))" "$RST"
          printf '%s│%s %s%s%s %s│%s\n' "$CYN" "$RST" "$BOLD$WHT" "$(pad "$t" $((w-4)))" "$RST" "$CYN" "$RST"
          printf '%s╰%s╯%s\n' "$CYN" "$(line $((w-2)))" "$RST"; }

ok()   { printf '%s%s%s %s\n' "$GRN" "$I_OK"   "$RST" "$*"; }
bad()  { printf '%s%s%s %s\n' "$RED" "$I_NO"   "$RST" "$*" >&2; }
warn() { printf '%s%s%s %s\n' "$YEL" "$I_WARN" "$RST" "$*"; }
info() { printf '%s%s%s %s\n' "$BLU" "$I_INFO" "$RST" "$*"; }
step() { printf '%s%s%s %s\n' "$MAG" "$I_UP"   "$RST" "$*"; }

os_icon() { case "${1,,}" in
      windows*)          printf '%s%s%s' "$BLU" "$I_WIN" "$RST" ;;
      linux*)            printf '%s%s%s' "$YEL" "$I_LNX" "$RST" ;;
      freebsd*|openbsd*) printf '%s%s%s' "$RED" "$I_BSD" "$RST" ;;
      macos*|osx*)       printf '%s%s%s' "$WHT" "$I_MAC" "$RST" ;;
      *)                 printf '%s%s%s' "$GRY" "$I_OTH" "$RST" ;;
    esac; }
diff_fmt() { local col; case "${1,,}" in
      easy)   col="$GRN" ;;  medium) col="$YEL" ;;
      hard)   col="$ORG" ;;  insane) col="$RED" ;;  *) col="$GRY" ;;
    esac; printf '%s%s %s%s' "$col" "$I_DOT" "$1" "$RST"; }
own_fmt()   { case "$1" in true|True|1) printf '%s%s%s' "$GRN" "$I_OWN" "$RST" ;;
                          *) printf '%s%s%s' "$GRY" "$I_NOOWN" "$RST" ;; esac; }
blood_fmt() { case "$1" in true|True|1) printf '%s%s%s' "$RED" "$I_BLOOD" "$RST" ;;
                          *) printf '%s%s%s' "$GRY" "$I_NONE" "$RST" ;; esac; }
rel_fmt()   { case "$1" in true|True|1) printf '%s%s live%s' "$GRN" "$I_DOT" "$RST" ;;
                          *) printf '%s%s soon%s' "$GRY" "$I_LOCK" "$RST" ;; esac; }
field()     { printf '   %s%s%s  %s\n' "$GRY" "$(pad "$1" 12)" "$RST" "$2"; }

# ================= Config =================

API="https://labs.hackthebox.com/api/v4"
API_V5="https://labs.hackthebox.com/api/v5"   # /machine/own was moved here (removed from v4)
TOKEN_FILE="${HTB_TOKEN_FILE:-$HOME/.config/htb/token}"
UA="Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"

# Directory containing your .ovpn files (labs, fortress, starting point, etc.). Auto-detected.
VPN_DIR="${HTB_VPN_DIR:-}"
if [ -z "$VPN_DIR" ]; then
    for _d in "$HOME/Desktop/c4sh3r/HTB/vpn" "$HOME/HTB/vpn" "$HOME/.config/htb/vpn"; do
        [ -d "$_d" ] && { VPN_DIR="$_d"; break; }
    done
    VPN_DIR="${VPN_DIR:-$HOME/.config/htb/vpn}"
fi

# Optional: always use this .ovpn file and skip the profile selector
VPN_FILE="${HTB_VPN_FILE:-}"
PID_FILE="${HTB_VPN_PID_FILE:-/run/htb-openvpn.pid}"

if [ -z "$HTB_TOKEN" ] && [ -f "$TOKEN_FILE" ]; then
    HTB_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
fi
case "${1:-}" in
    version|--version|-V|-h|--help|help|icons|font|setup-font|"") ;;
    *)
        if [ -z "$HTB_TOKEN" ]; then
            bad "No token found. Set \$HTB_TOKEN or store it in $TOKEN_FILE"
            exit 1
        fi ;;
esac

# ================= HTTP Helpers =================
api() {
    local method="$1" path="$2" body="$3"
    if [ -n "$body" ]; then
        curl -s --max-time 40 -X "$method" "$API$path" \
            -H "Authorization: Bearer $HTB_TOKEN" -H "User-Agent: $UA" \
            -H "Accept: application/json" -H "Content-Type: application/json" -d "$body"
    else
        curl -s --max-time 40 -X "$method" "$API$path" \
            -H "Authorization: Bearer $HTB_TOKEN" -H "User-Agent: $UA" \
            -H "Accept: application/json"
    fi
}
api5() {
    local method="$1" path="$2" body="$3"
    if [ -n "$body" ]; then
        curl -s --max-time 40 -X "$method" "$API_V5$path" \
            -H "Authorization: Bearer $HTB_TOKEN" -H "User-Agent: $UA" \
            -H "Accept: application/json" -H "Content-Type: application/json" -d "$body"
    else
        curl -s --max-time 40 -X "$method" "$API_V5$path" \
            -H "Authorization: Bearer $HTB_TOKEN" -H "User-Agent: $UA" \
            -H "Accept: application/json"
    fi
}

die() { bad "$*"; exit 1; }

resolve_id() {
    local q="$1"
    if [[ "$q" =~ ^[0-9]+$ ]]; then echo "$q"; return 0; fi
    local id
    id=$(api GET "/season/machines" | jq -r --arg n "$q" \
        '.data[]? | select(.name != null) | select(.name|ascii_downcase == ($n|ascii_downcase)) | .id' | head -1)
    if [ -n "$id" ] && [ "$id" != "null" ]; then echo "$id"; return 0; fi
    id=$(api GET "/machine/paginated?per_page=100" | jq -r --arg n "$q" \
        '.data[]? | select(.name != null) | select(.name|ascii_downcase == ($n|ascii_downcase)) | .id' | head -1)
    if [ -n "$id" ] && [ "$id" != "null" ]; then echo "$id"; return 0; fi
    id=$(api GET "/search/fetch?query=$q&tags=%5B%22machines%22%5D" 2>/dev/null \
        | jq -r --arg n "$q" '.machines[]? | select(.value|ascii_downcase == ($n|ascii_downcase)) | .id' 2>/dev/null | head -1)
    [ -n "$id" ] && [ "$id" != "null" ] && { echo "$id"; return 0; }
    return 1
}

active_id() { api GET "/machine/active" | jq -r '.info.id // empty'; }

# ================= Commands =================

cmd_whoami() {
    local out; out=$(api GET "/user/info")
    local name id vip srv
    name=$(echo "$out" | jq -r '.info.name // empty')
    [ -z "$name" ] && die "Invalid token or API is not responding"
    id=$(echo "$out"  | jq -r '.info.id')
    vip=$(echo "$out" | jq -r '.info.canAccessVIP')
    srv=$(echo "$out" | jq -r '.info.server_id // "n/a"')
    title "$I_USER  HackTheBox Session"
    field "User" "$BOLD$WHT$name$RST $GRY(id $id)$RST"
    if [ "$vip" = "true" ]; then field "VIP" "$(printf '%s%s yes%s' "$GRN" "$I_STAR" "$RST")"
    else field "VIP" "$(printf '%s%s no%s' "$GRY" "$I_NO" "$RST")"; fi
    field "Server" "$srv"
    echo
}

# Machine table header
_mach_header() {
    printf '  %s%s%s%s%s%s%s%s\n' \
        "$BOLD$GRY" "$(pad "ID" 7)" "$(pad "OS" 5)" "$(pad "MACHINE" 22)" \
        "$(pad "DIFFICULTY" 14)" "$(pad "RELEASE" 13)" "$(pad "USER" 6)$(pad "ROOT" 6)" "$RST"
    printf '  %s%s%s\n' "$GRY" "$(line 73)" "$RST"
}

_mach_row() { # id os name diff release userown rootown
    printf '  %s%s%s%s%s%s%s\n' \
        "$(pad "$WHT$1$RST" 7)" "$(pad "$(os_icon "$2")" 5)" \
        "$(pad "$BOLD$3$RST" 22)" "$(pad "$(diff_fmt "$4")" 14)" \
        "$(pad "$GRY$5$RST" 13)" "$(pad "$(own_fmt "$6")" 6)" "$(pad "$(own_fmt "$7")" 6)"
}

cmd_list() {
    local n="${1:-15}" rows
    title "$I_BOX  Latest $n Machines"
    rows=$(api GET "/machine/paginated?per_page=$n" \
        | jq -r '.data | sort_by(.release) | reverse | .[]
            | [.id,.os,.name,.difficultyText,(.release[0:10]),
               (.authUserInUserOwns|tostring),(.authUserInRootOwns|tostring)] | @tsv')
    [ -z "$rows" ] && { warn "No data available (check your token)"; return 1; }
    _mach_header
    local id os name diff rel u rt
    while IFS=$'\t' read -r id os name diff rel u rt; do
        _mach_row "$id" "$os" "$name" "$diff" "$rel" "$u" "$rt"
    done <<< "$rows"
    echo
}

cmd_season() {
    local raw rows
    title "$I_TGT  Active Season Machines"
    raw=$(api GET "/season/machines")
    rows=$(echo "$raw" | jq -r '.data[]? | [.id,.os,.name,.difficulty_text,(.release_time[0:10]),
                 (.is_released|tostring),(.is_user_blood|tostring),(.is_root_blood|tostring)] | @tsv')
    if [ -z "$rows" ]; then
        local why; why=$(echo "$raw" | jq -r '.message // empty')
        warn "No active season${why:+ $GRY(API: $why)$RST}"
        return 1
    fi
    printf '  %s%s%s%s%s%s%s%s\n' "$BOLD$GRY" "$(pad "ID" 7)" "$(pad "OS" 5)" \
        "$(pad "MACHINE" 22)" "$(pad "DIFFICULTY" 14)" "$(pad "RELEASE" 13)" \
        "$(pad "STATUS" 9)$(pad "BLOOD" 8)" "$RST"
    printf '  %s%s%s\n' "$GRY" "$(line 78)" "$RST"
    local id os name diff rel isrel ub rb
    while IFS=$'\t' read -r id os name diff rel isrel ub rb; do
        printf '  %s%s%s%s%s%s%s\n' \
            "$(pad "$WHT$id$RST" 7)" "$(pad "$(os_icon "$os")" 5)" \
            "$(pad "$BOLD$name$RST" 22)" "$(pad "$(diff_fmt "$diff")" 14)" \
            "$(pad "$GRY$rel$RST" 13)" "$(pad "$(rel_fmt "$isrel")" 9)" \
            "$(pad "$(blood_fmt "$ub")$(blood_fmt "$rb")" 8)"
    done <<< "$rows"
    printf '  %s%s%s = user blood   %s%s%s = root blood (2nd)%s\n\n' \
        "$RED" "$I_BLOOD" "$GRY" "$RED" "$I_BLOOD" "$GRY" "$RST"
    echo
}

cmd_latest() {
    local out; out=$(api GET "/machine/paginated?per_page=20" \
        | jq -r '.data | sort_by(.release) | reverse | .[0]
            | [.id,.os,.name,.difficultyText,.release,(.active|tostring)] | @tsv')
    [ -z "$out" ] && die "Failed to query the API"
    local id os name diff rel act
    IFS=$'\t' read -r id os name diff rel act <<< "$out"
    title "$I_UP  Latest Release"
    field "Machine"    "$(os_icon "$os")  $BOLD$WHT$name$RST $GRY(id $id)$RST"
    field "OS"         "$os"
    field "Difficulty" "$(diff_fmt "$diff")"
    field "Release"    "$GRY${rel:0:19}$RST"
    if [ "$act" = "true" ]; then field "Status" "$(printf '%s%s active%s' "$GRN" "$I_DOT" "$RST")"
    else field "Status" "$(printf '%s%s inactive%s' "$GRY" "$I_NO" "$RST")"; fi
    echo
}

# Authenticated user's ID (to determine whether a blood belongs to you)
self_id() {
    [ -n "$SELF_ID" ] || SELF_ID=$(api GET "/user/info" | jq -r '.info.id // empty')
    printf '%s' "$SELF_ID"
}

# Display a blood: name, time, and whether it belongs to you
blood_line() {
    local who="$1" wid="$2" tdiff="$3" me
    if [ -z "$who" ] || [ "$who" = "null" ] || [ "$who" = "-" ]; then
        printf '%sno blood claimed%s' "$GRY" "$RST"; return
    fi
    me=$(self_id)
    if [ -n "$me" ] && [ "$wid" = "$me" ]; then
        printf '%s%s %s  %s%s  <- YOURS%s' "$RED$BOLD" "$I_BLOOD" "$who" "$tdiff" "$YEL" "$RST"
    else
        printf '%s%s%s %s  %s%s%s' "$RED" "$I_BLOOD" "$RST" "$who" "$GRY" "$tdiff" "$RST"
    fi
}

cmd_info() {
    local id; id=$(resolve_id "$1") || die "Machine '$1' not found"
    local out; out=$(api GET "/machine/profile/$id" \
        | jq -r '.info | [.id,.os,.name,.difficultyText,(.ip//"-"),(.points//0),.release,
                 (.active|tostring),(.authUserInUserOwns|tostring),(.authUserInRootOwns|tostring),
                 (.userBlood.user.name//"-"),(.userBlood.user.id//"-"),(.userBlood.blood_difference//"-"),
                 (.rootBlood.user.name//"-"),(.rootBlood.user.id//"-"),(.rootBlood.blood_difference//"-"),
                 (.authUserFirstUserTime//"-"),(.authUserFirstRootTime//"-"),(.ownRank//"-")] | @tsv')
    [ -z "$out" ] && die "Failed to retrieve the machine profile"
    local mid os name diff ip pts rel act uo ro ubn ubi ubd rbn rbi rbd fut frt rank
    IFS=$'\t' read -r mid os name diff ip pts rel act uo ro ubn ubi ubd rbn rbi rbd fut frt rank <<< "$out"
    title "$(os_icon "$os")  $name"
    field "ID"         "$WHT$mid$RST"
    field "OS"         "$(os_icon "$os")  $os"
    field "Difficulty" "$(diff_fmt "$diff")"
    field "Points"     "$pts"
    field "IP"         "$( [ "$ip" != "-" ] && [ "$ip" != "null" ] && printf '%s%s%s' "$GRN$BOLD" "$ip" "$RST" || printf '%s(not spawned)%s' "$GRY" "$RST")"
    field "Release"    "$GRY${rel:0:10}$RST"
    field "Active"     "$( [ "$act" = true ] && printf '%s%s yes%s' "$GRN" "$I_DOT" "$RST" || printf '%s%s no%s' "$GRY" "$I_NO" "$RST")"
    printf '\n'
    field "User own"   "$(own_fmt "$uo")$( [ "$fut" != "-" ] && printf '  %sat %s%s' "$GRY" "$fut" "$RST")"
    field "Root own"   "$(own_fmt "$ro")$( [ "$frt" != "-" ] && printf '  %sat %s%s' "$GRY" "$frt" "$RST")"
    [ "$rank" != "-" ] && field "Your rank" "#$rank"
    printf '\n'
    # Resolve your own ID here (inside $(...), the cache would be lost in the subshell)
    if [ "$ubn" != "-" ] || [ "$rbn" != "-" ]; then self_id >/dev/null; fi
    field "User blood" "$(blood_line "$ubn" "$ubi" "$ubd")"
    field "Root blood" "$(blood_line "$rbn" "$rbi" "$rbd")"
    echo
}

cmd_active() {
    local out; out=$(api GET "/machine/active")
    if [ "$(echo "$out" | jq -r '.info')" = "null" ]; then
        warn "You don't have any machine spawned."
        printf '   %sStart one with:%s htb spawn <name>\n' "$GRY" "$RST"
        return 0
    fi
    local name id ip exp
    name=$(echo "$out" | jq -r '.info.name'); id=$(echo "$out" | jq -r '.info.id')
    ip=$(echo "$out"   | jq -r '.info.ip // "n/a"'); exp=$(echo "$out" | jq -r '.info.expires_at // "n/a"')
    title "$I_TGT  Active Machine"
    field "Machine" "$BOLD$WHT$name$RST $GRY(id $id)$RST"
    field "IP"      "$GRN$BOLD$ip$RST"
    field "Expires" "$GRY$exp$RST"
    echo
}

cmd_spawn() {
    [ -z "$1" ] && die "Usage: htb spawn <name|id>"
    local id; id=$(resolve_id "$1") || die "Machine '$1' not found"
    step "Spawning machine ID $id ..."
    local out; out=$(api POST "/vm/spawn" "{\"machine_id\": $id}")
    ok "$(echo "$out" | jq -r '.message // .error // .')"
    cmd_ip "$id"
}

cmd_stop() {
    local id; id="${1:-$(active_id)}"
    [ -z "$id" ] && die "No active machine to stop"
    [[ "$id" =~ ^[0-9]+$ ]] || id=$(resolve_id "$id") || die "Machine '$1' not found"
    local out; out=$(api POST "/vm/terminate" "{\"machine_id\": $id}")
    ok "$(echo "$out" | jq -r '.message // .')"
}

cmd_reset() {
    local id; id="${1:-$(active_id)}"
    [ -z "$id" ] && die "No active machine to reset"
    [[ "$id" =~ ^[0-9]+$ ]] || id=$(resolve_id "$id") || die "Machine '$1' not found"
    local out; out=$(api POST "/vm/reset" "{\"machine_id\": $id}")
    ok "$(echo "$out" | jq -r '.message // .')"
}

cmd_ip() {
    local id="${1:-$(active_id)}"
    [ -n "$id" ] && [[ ! "$id" =~ ^[0-9]+$ ]] && id=$(resolve_id "$id")
    local i ip spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' fr
    [ "$ICONSET" = ascii ] && spin='|/-\'
    for i in $(seq 1 40); do
        ip=$(api GET "/machine/active" | jq -r '.info.ip // empty')
        if [ -n "$ip" ] && [ "$ip" != "null" ]; then
            [ -t 1 ] && printf '\r\e[K'
            ok "IP: $GRN$BOLD$ip$RST"
            if echo "$ip" | tr -d '\n' | xclip -selection clipboard 2>/dev/null; then
                printf '   %scopied to clipboard%s\n' "$GRY" "$RST"
            fi
            return 0
        fi
        if [ -t 1 ]; then
            fr="${spin:$(( (i-1) % ${#spin} )):1}"
            printf '\r%s%s%s waiting for IP... %ss ' "$CYN" "$fr" "$RST" "$((i*2))"
        fi
        sleep 2
    done
    [ -t 1 ] && printf '\r\e[K'
    bad "The machine does not have an IP address yet (it is still starting up). Try again: htb ip"
    return 1
}

cmd_host() {
    [ "$#" -ge 1 ] || die "Usage: htb host <domain> <domain2> <domain3> ..."

    local ip; ip=$(api GET "/machine/active" | jq -r '.info.ip // empty')
    [ -n "$ip" ] && [ "$ip" != "null" ] || die "No active machine with an IP address. Spawn one: htb spawn <name>"

    local domains="$*"
    local entry="$ip    $domains"
    local hosts="/etc/hosts"
    local marker="HTB"
    local pattern
    pattern=$(printf '%s\n' "$@" | paste -sd '|')

    if grep -qE "[[:space:]](${pattern})(\$|[[:space:]])" "$hosts"; then
        sudo sed -i -E "s/.*[[:space:]](${pattern})(\$|[[:space:]].*)?\$/$entry/" "$hosts"
        ok "Updated: $BOLD$domains$RST -> $GRN$BOLD$ip$RST"
    elif grep -qF "$ip" "$hosts"; then
        sudo sed -i "s/^${ip}[[:space:]].*/$entry/" "$hosts"
        ok "IP $GRN$BOLD$ip$RST updated with domains: $domains"
    else
        if grep -qE "^#[[:space:]]*${marker}" "$hosts"; then
            sudo sed -i -E "/^#[[:space:]]*${marker}/a ${entry}" "$hosts"
            ok "Added after #HTB: $BOLD$entry$RST"
        else
            printf '\n#%s\n' "$marker" | sudo tee -a "$hosts" > /dev/null
            printf '%s\n' "$entry"     | sudo tee -a "$hosts" > /dev/null
            ok "Created #HTB section and added: $BOLD$entry$RST"
        fi
    fi
}

cmd_own() {
    local id flag diff="50"
    if [ -n "$2" ] && [[ ! "$1" =~ ^[a-f0-9]{30,}$ ]]; then
        id=$(resolve_id "$1") || die "Machine '$1' not found"
        flag="$2"; [ -n "$3" ] && diff="$3"
    else
        flag="$1"; [ -n "$2" ] && diff="$2"
        id=$(active_id)
        [ -z "$id" ] && die "No active machine. Use: htb own <name> <flag>"
    fi
    [ -z "$flag" ] && die "Missing flag"
    step "Submitting flag for machine ID $id $GRY(difficulty $diff)$RST"
    local out; out=$(api5 POST "/machine/own" "{\"flag\":\"$flag\",\"id\":$id,\"difficulty\":$diff}")
    local msg; msg=$(echo "$out" | jq -r '.message // .status // .')
    if echo "$msg" | grep -qiE "incorrect|invalid|wrong|not found|error|can ?not|cannot|accessed"; then
        bad "$msg"; return 1
    fi
    printf '%s%s  %s%s\n' "$GRN$BOLD" "$I_FLAG" "$msg" "$RST"
}

# ================= VPN: profiles and products =================

# Aliases the user can enter -> HTB API product
vpn_product() {
    case "${1,,}" in
        labs|lab|machines|machine|vip|maquinas|maquina) printf 'labs' ;;
        sp|start|starting|startingpoint|starting_point) printf 'starting_point' ;;
        fort|fortress|fortresses|fortaleza|fortalezas)  printf 'fortresses' ;;
        arena|release|release_arena|releasearena)       printf 'release_arena' ;;
        season|competitive|comp)                        printf 'competitive' ;;
        pro|prolab|prolabs|pro_lab|pl)                   printf 'prolab' ;;
        *) return 1 ;;
    esac
}
VPN_PRODUCTS=(labs starting_point fortresses release_arena competitive)

# Pro Labs are not requested via ?product=; they use an ID and their own endpoint.
# Resolve a Pro Lab name or ID -> numeric ID (list available labs if no match is found).
prolab_resolve() {
    local q="$1" json id
    json=$(api GET "/prolabs")
    [ "$(echo "$json" | jq -r '.status // empty')" = "true" ] \
        || { bad "Unable to list Pro Labs (check your token)" >&2; return 1; }
    if [ -z "$q" ]; then
        bad "Specify a Pro Lab:  htb vpn prolab <name|id>" >&2
        echo "$json" | jq -r '.data.labs[]? | "     \(.id)\t\(.name)"' | sort -n >&2
        return 1
    fi
    if [[ "$q" =~ ^[0-9]+$ ]]; then printf '%s' "$q"; return 0; fi
    id=$(echo "$json" | jq -r --arg q "$q" '.data.labs[]?
            | select((.name|ascii_downcase)==($q|ascii_downcase)) | .id' | head -1)
    [ -z "$id" ] && id=$(echo "$json" | jq -r --arg q "$q" '.data.labs[]?
            | select(.name|ascii_downcase|contains($q|ascii_downcase)) | .id' | head -1)
    if [ -z "$id" ]; then
        bad "No Pro Lab found matching '$q'" >&2
        echo "$json" | jq -r '.data.labs[]? | "     \(.id)\t\(.name)"' | sort -n >&2
        return 1
    fi
    printf '%s' "$id"
}

# Filename patterns for each product (for 'htb connect fortress')
vpn_product_pat() {
    case "$1" in
        labs)           printf 'lab|machine|vip|dedivip|htb' ;;
        starting_point) printf 'start|_sp|^sp' ;;
        fortresses)     printf 'fort' ;;
        release_arena)  printf 'arena|release' ;;
        competitive)    printf 'competitive|season' ;;
        prolab)         printf 'prolab' ;;
        *)              return 1 ;;
    esac
}

# "remote edge-eu-fort-1.hackthebox.eu 1337" -> "edge-eu-fort-1.hackthebox.eu"
ovpn_remote() { sed -n 's/^remote[[:space:]]\+\([^[:space:]]*\).*/\1/p' "$1" 2>/dev/null | head -1; }

# ... -> "eu-fort-1"
ovpn_slug()   { local h; h=$(ovpn_remote "$1"); h="${h%.hackthebox.*}"; printf '%s' "${h#edge-}"; }

# Human-readable label derived from the filename or slug
ovpn_kind() {
    case "${1,,}" in
        *prolab*)          printf 'Pro Lab' ;;
        *fort*)            printf 'Fortress' ;;
        *start*|*-sp-*)    printf 'Starting Point' ;;
        *endgame*|*-eg-*)  printf 'Endgame' ;;
        *release*|*arena*) printf 'Release Arena' ;;
        *dedivip*|*vip*)   printf 'Labs VIP+' ;;
        *free*)            printf 'Labs Free' ;;
        *lab*|*machine*)   printf 'Labs' ;;
        *)                 printf '-' ;;
    esac
}

# Read user input from the actual terminal when possible, otherwise from stdin
# (this also works inside $(...) and in environments where /dev/tty cannot be opened)
ask() {
    if { : < /dev/tty; } 2>/dev/null; then read -r "$1" < /dev/tty
    else read -r "$1"; fi
}

# Truncate text to <width>, appending an ellipsis (plain text only, without ANSI codes)
trunc() {
    local t="$1" w="$2" e='…'
    [ "$ICONSET" = ascii ] && e='~'
    [ "${#t}" -le "$w" ] && { printf '%s' "$t"; return; }
    printf '%s%s' "${t:0:$((w-1))}" "$e"
}

list_ovpn() {
    [ -d "$VPN_DIR" ] || return 1
    find "$VPN_DIR" -maxdepth 3 -type f -name '*.ovpn' 2>/dev/null | sort
}

find_ovpn_by_remote() {
    local host="$1" f
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        [ "$(ovpn_remote "$f")" = "$host" ] && { printf '%s' "$f"; return 0; }
    done < <(list_ovpn)
    return 1
}

# Resolve an argument to the path of an .ovpn file.
# Accepts: path, exact filename, partial filename, or product alias.
# rc 0 = one match on stdout | 1 = no matches | 2 = multiple matches, all on stdout
resolve_ovpn() {
    local q="$1" prod pat hits n f
    [ -n "$q" ] || return 1

    # 1) Profile name inside VPN_DIR (before checking relative paths: otherwise,
    #    'htb connect htb' could select the script itself when run from the repo)
    [ -f "$VPN_DIR/$q.ovpn" ]  && { printf '%s' "$VPN_DIR/$q.ovpn"; return 0; }
    [ -f "$VPN_DIR/$q" ]       && { printf '%s' "$VPN_DIR/$q"; return 0; }

    # 2) Explicit path, but only if it looks like one
    case "$q" in
        */*|*.ovpn) [ -f "$q" ] && { printf '%s' "$q"; return 0; } ;;
    esac

    if prod=$(vpn_product "$q"); then
        pat=$(vpn_product_pat "$prod")
    else
        pat=$(printf '%s' "$q" | sed 's/[][\.^$*+?(){}|\\]/\\&/g')
    fi

    hits=$(while IFS= read -r f; do
               [ -n "$f" ] || continue
               printf '%s' "$(basename "$f")" | grep -qiE "$pat" && printf '%s\n' "$f"
           done < <(list_ovpn))

    n=$(printf '%s' "$hits" | grep -c .)
    [ "$n" -eq 1 ] && { printf '%s' "$hits"; return 0; }
    [ "$n" -gt 1 ] && { printf '%s' "$hits"; return 2; }
    return 1
}

# Interactive menu. The list goes to stderr; the selected path goes to stdout.
pick_ovpn() {
    local files=() f i n sel cur base
    while IFS= read -r f; do [ -n "$f" ] && files+=("$f"); done < <(list_ovpn)
    n=${#files[@]}
    if [ "$n" -eq 0 ]; then
        bad "No .ovpn files found in $VPN_DIR"
        printf '   %sDownload one:  htb vpn labs   |   htb vpn fortress%s\n' "$GRY" "$RST" >&2
        return 1
    fi
    [ "$n" -eq 1 ] && { printf '%s' "${files[0]}"; return 0; }
    if [ "$IS_TTY" != 1 ]; then
        bad "There are $n VPN profiles. Specify one: htb connect <profile>" >&2
        return 1
    fi
    cur=$(htb_vpn_config) || cur=""
    printf '\n  %sVPN profiles in %s%s\n\n' "$GRY" "$VPN_DIR" "$RST" >&2
    for i in "${!files[@]}"; do
        f="${files[$i]}"; base=$(basename "$f")
        printf '    %s%s)%s ' "$BOLD$WHT" "$((i+1))" "$RST" >&2
        cell "$(ovpn_kind "$base $(ovpn_slug "$f")")" 16 >&2
        cell "$GRY$(ovpn_remote "$f")$RST" 40 >&2
        [ "$f" = "$cur" ] && printf ' %s%s connected%s' "$GRN" "$I_DOT" "$RST" >&2
        printf '\n       %s%s%s\n' "$GRY" "$(trunc "$base" 56)" "$RST" >&2
    done
    printf '\n  %sChoose [1-%s]: %s' "$GRY" "$n" "$RST" >&2
    ask sel
    [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "$n" ] \
        || { bad "Invalid selection." >&2; return 1; }
    printf '%s' "${files[$((sel-1))]}"
}

cmd_vpns() {
    local files=() f i n cur base
    while IFS= read -r f; do [ -n "$f" ] && files+=("$f"); done < <(list_ovpn)
    n=${#files[@]}
    title "VPN Profiles   $VPN_DIR"
    if [ "$n" -eq 0 ]; then
        warn "No .ovpn files yet. Download one:  htb vpn labs  |  htb vpn fortress"
        return 0
    fi
    cur=$(htb_vpn_config) || cur=""
    for f in "${files[@]}"; do
        base=$(basename "$f")
        if [ "$f" = "$cur" ]; then printf '  %s%s%s ' "$GRN" "$I_DOT" "$RST"
        else                        printf '  %s%s%s ' "$GRY" "$I_NONE" "$RST"; fi
        cell "$BOLD$WHT$(trunc "${base%.ovpn}" 28)$RST" 30
        cell "$(ovpn_kind "$base $(ovpn_slug "$f")")" 16
        printf '%s%s%s' "$GRY" "$(ovpn_remote "$f")" "$RST"
        [ "$f" = "$cur" ] && printf '  %s%s connected%s' "$GRN" "$I_OK" "$RST"
        echo
    done
    printf '\n  %sConnect:  htb connect <profile>   (or simply: htb connect)%s\n\n' "$GRY" "$RST"
}

# Download a product's .ovpn file (labs, fortresses, ...) from the API.
cmd_vpn() {
    local prod="" arg="" arg2="" out="" tcp=0 pick=0 a
    while [ $# -gt 0 ]; do
        case "$1" in
            -o|--out)   out="$2"; shift 2 ;;
            --tcp)      tcp=1; shift ;;
            -p|--pick)  pick=1; shift ;;
            -h|--help)  vpn_help; return 0 ;;
            -*)         die "Unknown option: $1" ;;
            *)          if [ -z "$arg" ]; then arg="$1"; else arg2="$arg2 $1"; fi; shift ;;
        esac
    done
    arg2="${arg2# }"

    if [ -z "$arg" ]; then cmd_vpn_products; return 0; fi
    prod=$(vpn_product "$arg") || die "Unknown product: $arg  (${VPN_PRODUCTS[*]}, prolab)"

    local json
    if [ "$prod" = prolab ]; then
        # Pro Labs use an ID and a dedicated endpoint: /connections/servers/prolab/<id>
        local labid; labid=$(prolab_resolve "$arg2") || return 1
        step "Querying servers for Pro Lab $BOLD$labid$RST ..."
        json=$(api GET "/connections/servers/prolab/$labid")
        [ "$(echo "$json" | jq -r '.status // empty')" = "true" ] \
            || die "The API returned no servers for Pro Lab '$arg2' (do you have access to this lab?)"
    else
        step "Querying servers for $BOLD$prod$RST ..."
        json=$(api GET "/connections/servers?product=$prod")
        [ "$(echo "$json" | jq -r '.status // empty')" = "true" ] \
            || die "The API returned no servers for '$prod' (do you have access to this product?)"
    fi

    local sid sname
    if [ "$pick" = 1 ]; then
        local rows=() row i sel
        while IFS= read -r row; do [ -n "$row" ] && rows+=("$row"); done < <(
            echo "$json" | jq -r '.data.options // {} | to_entries[] | .value | to_entries[] | .value.servers // {}
                                  | to_entries[] | .value | "\(.id)\t\(.friendly_name)\t\(.location)\t\(.current_clients)\t\(.full)"')
        [ "${#rows[@]}" -eq 0 ] && die "No servers available for '$prod'"
        printf '\n' >&2
        for i in "${!rows[@]}"; do
            IFS=$'\t' read -r sid sname _ _ _ <<< "${rows[$i]}"
            local _loc _cli _full; IFS=$'\t' read -r _ _ _loc _cli _full <<< "${rows[$i]}"
            printf '    %s%s)%s ' "$BOLD$WHT" "$((i+1))" "$RST" >&2
            cell "$sname" 26 >&2
            printf '%s%s  %s clients%s' "$GRY" "$_loc" "$_cli" "$RST" >&2
            [ "$_full" = "true" ] && printf ' %sFULL%s' "$RED" "$RST" >&2
            echo >&2
        done
        printf '\n  %sChoose [1-%s]: %s' "$GRY" "${#rows[@]}" "$RST" >&2
        ask sel
        [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#rows[@]}" ] \
            || die "Invalid selection."
        IFS=$'\t' read -r sid sname _ <<< "${rows[$((sel-1))]}"
    else
        sid=$(echo   "$json" | jq -r '.data.assigned.id // empty')
        sname=$(echo "$json" | jq -r '.data.assigned.friendly_name // empty')
        [ -n "$sid" ] || die "No server assigned for '$prod'. Use --pick to choose one."
    fi

    mkdir -p "$VPN_DIR"
    local tmp; tmp=$(mktemp) || die "Failed to create a temporary file"
    step "Downloading $BOLD$sname$RST $GRY(id $sid$([ "$tcp" = 1 ] && echo ', tcp'))$RST ..."
    curl -s --max-time 60 "$API/access/ovpnfile/$sid/$tcp" \
        -H "Authorization: Bearer $HTB_TOKEN" -H "User-Agent: $UA" -o "$tmp"

    if ! grep -q '^remote ' "$tmp" 2>/dev/null; then
        bad "Invalid download (has the token expired or is the server full?)"
        head -c 200 "$tmp"; echo; rm -f "$tmp"; return 1
    fi

    local host slug dest prev
    host=$(ovpn_remote "$tmp"); slug=$(ovpn_slug "$tmp")
    if [ -n "$out" ]; then
        dest="$out"
    elif prev=$(find_ovpn_by_remote "$host"); then
        dest="$prev"                       # already downloaded: update it in place
    else
        if [ "$(ovpn_kind "$slug")" = "-" ]; then dest="$VPN_DIR/${prod}_${slug}.ovpn"
        else                                       dest="$VPN_DIR/${slug}.ovpn"; fi
    fi
    mv "$tmp" "$dest" && chmod 600 "$dest"
    ok "VPN profile saved to $BOLD$dest$RST  $GRY($host)$RST"
    printf '   %sConnect:%s htb connect %s%s%s\n' "$GRY" "$RST" "$BOLD$WHT" "$(basename "${dest%.ovpn}")" "$RST"
}

# Overview: which VPN product is assigned to which server
cmd_vpn_products() {
    local p json name loc
    title "HackTheBox VPN Products"
    for p in "${VPN_PRODUCTS[@]}"; do
        json=$(api GET "/connections/servers?product=$p")
        printf '  '
        cell "$BOLD$WHT$p$RST" 20
        if [ "$(echo "$json" | jq -r '.status // empty')" = "true" ]; then
            name=$(echo "$json" | jq -r '.data.assigned.friendly_name // "-"')
            loc=$(echo  "$json" | jq -r '.data.assigned.location // ""')
            cell "$GRN$name$RST" 26
            printf '%s%s%s\n' "$GRY" "$loc" "$RST"
        else
            printf '%sno access%s\n' "$GRY" "$RST"
        fi
    done
    printf '\n  %sDownload:%s htb vpn fortress      %s(--pick to choose a server)%s\n' \
        "$GRY" "$RST" "$GRY" "$RST"
    printf '  %sPro Labs:%s  htb vpn prolab <name>  %s(htb vpn prolab lists available labs)%s\n' \
        "$GRY" "$RST" "$GRY" "$RST"
    printf '  %sAliases:%s labs, sp, fortress, arena, season\n\n' "$GRY" "$RST"
}

vpn_help() {
    printf '\n  %shtb vpn [product] [options]%s\n\n' "$BOLD$WHT" "$RST"
    printf '    %sno product%s    list products and your assigned server\n' "$GRY" "$RST"
    printf '    %sproduct%s      labs | sp | fortress | arena | season\n' "$GRY" "$RST"
    printf '    %sprolab <name>%s VPN for a Pro Lab (without a name: list available labs)\n' "$GRY" "$RST"
    printf '    %s-p, --pick%s   choose a specific server instead of the assigned one\n' "$GRY" "$RST"
    printf '    %s--tcp%s        download the TCP variant\n' "$GRY" "$RST"
    printf '    %s-o <path>%s    save to a specific path\n\n' "$GRY" "$RST"
}

as_root() {
    local SP="$HOME/.config/htb/sudo.pass"
    if [ -f "$SP" ]; then sudo -S -k "$@" < "$SP"; else sudo "$@"; fi
}

tun_ip() { ip -4 -o a show "${1:-tun0}" 2>/dev/null | awk '{print $4}' | head -1; }

htb_vpn_pid() {
    local pid
    [ -r "$PID_FILE" ] || return 1
    pid=$(tr -dc '0-9' < "$PID_FILE"); [ -n "$pid" ] || return 1
    [ -d "/proc/$pid" ] || return 1
    [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = "openvpn" ] || return 1
    echo "$pid"
}

# Path to the .ovpn file used to start a specific OpenVPN process
openvpn_config_of() {
    tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null | awk '/^--config$/{getline; print; exit}'
}

# Profile currently used by the VPN connection started by htb
htb_vpn_config() {
    local pid cfg
    pid=$(htb_vpn_pid) || return 1
    cfg=$(openvpn_config_of "$pid"); [ -n "$cfg" ] || return 1
    printf '%s' "$cfg"
}

openvpn_pids_for_config() {
    local f="$1" pid
    for pid in $(pgrep -x openvpn 2>/dev/null); do
        [ "$(openvpn_config_of "$pid")" = "$f" ] && echo "$pid"
    done
}

# OpenVPN processes started with a .ovpn file from our VPN_DIR (in case the PID file was lost)
openvpn_pids_in_vpndir() {
    local pid cfg
    for pid in $(pgrep -x openvpn 2>/dev/null); do
        cfg=$(openvpn_config_of "$pid")
        case "$cfg" in "$VPN_DIR"/*) echo "$pid" ;; esac
    done
}

cmd_connect() {
    local f="" force=0 a target rc cur ans i
    for a in "$@"; do
        case "$a" in
            -f|--force|-y|--yes) force=1 ;;
            -*) die "Unknown option: $a" ;;
            *)  [ -z "$f" ] && f="$a" ;;
        esac
    done

    if [ -n "$f" ]; then
        target=$(resolve_ovpn "$f"); rc=$?
        if [ "$rc" = 2 ]; then
            bad "'$f' matches multiple profiles:"
            printf '%s\n' "$target" | while IFS= read -r a; do
                printf '   %s- %s%s\n' "$GRY" "$(basename "$a")" "$RST"; done
            return 1
        elif [ "$rc" != 0 ]; then
            bad "No .ovpn file found for '$f' in $VPN_DIR"
            printf '   %sList profiles: htb vpns   |   Download one: htb vpn %s%s\n' "$GRY" "$f" "$RST"
            return 1
        fi
    elif [ -n "$VPN_FILE" ]; then
        target="$VPN_FILE"
    else
        target=$(pick_ovpn) || return 1
    fi
    [ -f "$target" ] || die "File does not exist: $target"

    cur=$(htb_vpn_config) || cur=""
    if [ -n "$cur" ]; then
        if [ "$cur" = "$target" ]; then
            ok "Already connected using $BOLD$(basename "$cur")$RST: $GRN$BOLD$(tun_ip)$RST"
            return 0
        fi
        warn "An htb VPN connection is already active: $BOLD$(basename "$cur")$RST"
        if [ "$force" = 1 ]; then
            info "Switching to $(basename "$target") ..."
        elif [ "$IS_TTY" = 1 ]; then
            printf '   %sSwitch to %s? [y/N]: %s' "$GRY" "$(basename "$target")" "$RST"
            ask ans
            case "${ans,,}" in y|yes|s|si|sí) ;; *) info "No changes made."; return 0 ;; esac
        else
            bad "Use -f to switch VPNs without prompting."
            return 1
        fi
        cmd_disconnect || return 1
    elif ip a show tun0 &>/dev/null; then
        ok "tun0 is already up $GRY(VPN not managed by htb)$RST: $GRN$(tun_ip)$RST"
        return 0
    fi

    step "Connecting $BOLD$(basename "$target")$RST $GRY(sudo)$RST"
    as_root openvpn --config "$target" --daemon --writepid "$PID_FILE" --log /tmp/htb_vpn.log
    for i in $(seq 1 15); do
        sleep 1
        if ip a show tun0 &>/dev/null; then
            ok "VPN connected $GRY($(ovpn_kind "$(basename "$target") $(ovpn_slug "$target")"))$RST: $GRN$BOLD$(tun_ip)$RST"
            return 0
        fi
    done
    bad "tun0 did not appear. Check /tmp/htb_vpn.log"
    tail -5 /tmp/htb_vpn.log
}

cmd_disconnect() {
    local f="" pid pids n i cfg
    if [ -n "${1:-}" ]; then f=$(resolve_ovpn "$1") || f="$1"; fi
    pid=$(htb_vpn_pid) || pid=""
    if [ -z "$pid" ]; then
        if [ -n "$f" ]; then pids=$(openvpn_pids_for_config "$f")
        else                 pids=$(openvpn_pids_in_vpndir); fi
        n=$(printf '%s' "$pids" | grep -c .)
        if [ "$n" -eq 1 ]; then pid="$pids"
        elif [ "$n" -gt 1 ]; then
            bad "There are $n htb OpenVPN processes. Specify which one: htb disconnect <profile>"
            pgrep -a -x openvpn >&2; return 1
        fi
    fi
    if [ -z "$pid" ]; then
        if pgrep -x openvpn &>/dev/null; then
            warn "OpenVPN is running, but htb did not start any of its processes."
            printf '   %sLeaving other VPN connections untouched. Current processes:%s\n' "$GRY" "$RST"
            pgrep -a -x openvpn
            return 1
        fi
        warn "No htb VPN connection found."
        return 0
    fi
    cfg=$(openvpn_config_of "$pid")
    step "Disconnecting $BOLD${cfg:+$(basename "$cfg")}$RST $GRY(pid $pid, sudo)$RST"
    as_root kill "$pid"
    for i in $(seq 1 15); do
        if [ ! -d "/proc/$pid" ]; then
            as_root rm -f "$PID_FILE"
            ok "VPN disconnected (process $pid terminated)."
            ip a show tun0 &>/dev/null && warn "Note: tun0 is still up (another VPN may be active)."
            return 0
        fi
        sleep 1
    done
    bad "Process $pid is still running. Try: sudo kill -9 $pid"
    return 1
}

cmd_vpnstatus() {
    local pid cfg addr
    pid=$(htb_vpn_pid) || pid=""
    cfg=$(htb_vpn_config) || cfg=""
    addr=$(tun_ip)
    if [ -n "$addr" ]; then
        printf '%s%s%s  VPN connected  %s%s%s\n' "$GRN" "$I_NET" "$RST" "$GRN$BOLD" "$addr" "$RST"
        if [ -n "$cfg" ]; then
            printf '   %sprofile:%s %s%s%s %s(%s)%s\n' "$GRY" "$RST" "$WHT" "$(basename "$cfg")" "$RST" \
                "$GRY" "$(ovpn_kind "$(basename "$cfg") $(ovpn_slug "$cfg")")" "$RST"
        fi
        if [ -n "$pid" ]; then printf '   %shtb-managed openvpn: pid %s%s\n' "$GRY" "$pid" "$RST"
        else                   printf '   %stun0 is up, but htb did not start it%s\n' "$GRY" "$RST"; fi
    else
        printf '%s%s%s  No tun0 interface (VPN disconnected)  %s-> htb connect%s\n' \
            "$RED" "$I_NET" "$RST" "$GRY" "$RST"
    fi
}

# NOTE: "fc-list | grep -q" breaks with 'set -o pipefail': grep exits on the first match,
# fc-list receives SIGPIPE, causing the pipeline to return an error. grep -c reads all input.
font_installed() {
    local n
    n=$(fc-list 2>/dev/null | grep -ci "$1 Nerd Font") || n=0
    [ "${n:-0}" -gt 0 ] 2>/dev/null
}

# Install a Nerd Font without using the system package manager:
# works on Arch, Debian/Ubuntu, Fedora, Void, macOS, and more...
cmd_font() {
    local name="${1:-Hack}"
    local ver="${HTB_NF_VERSION:-v3.4.0}"
    local url="https://github.com/ryanoasis/nerd-fonts/releases/download/$ver/$name.zip"
    local dir tmp zip

    if [ "$(uname -s)" = "Darwin" ]; then dir="$HOME/Library/Fonts"
    else dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"; fi
    dir="$dir/${name}NerdFont"

    if font_installed "$name"; then
        ok "'$name Nerd Font' is already installed."
        printf '   %sYou only need to select it as your terminal font.%s\n' "$GRY" "$RST"
        return 0
    fi

    command -v curl >/dev/null 2>&1 || die "curl is required"
    tmp=$(mktemp -d) || die "Failed to create a temporary directory"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" RETURN
    zip="$tmp/$name.zip"

    step "Downloading $name Nerd Font ($ver)..."
    if ! curl -fsSL --retry 2 --max-time 300 -o "$zip" "$url"; then
        bad "Failed to download $url"
        printf '   %sCheck the font name. Available fonts: https://github.com/ryanoasis/nerd-fonts/releases%s\n' "$GRY" "$RST"
        return 1
    fi

    mkdir -p "$dir" || die "Failed to create $dir"
    step "Extracting to $dir ..."
    if   command -v unzip  >/dev/null 2>&1; then unzip -oq "$zip" -d "$dir"
    elif command -v bsdtar >/dev/null 2>&1; then bsdtar -xf "$zip" -C "$dir"
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c 'import sys,zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "$zip" "$dir"
    else
        bad "unzip, bsdtar, or python3 is required to extract the ZIP file"; return 1
    fi

    # Remove files that are not fonts
    find "$dir" -maxdepth 1 -type f \( -iname '*.md' -o -iname '*.txt' \) -delete 2>/dev/null

    if command -v fc-cache >/dev/null 2>&1; then
        step "Updating font cache..."
        fc-cache -f "$dir" >/dev/null 2>&1 || fc-cache -f >/dev/null 2>&1
    else
        warn "fc-cache (fontconfig) is not available. It is not required on macOS."
    fi

    if font_installed "$name"; then
        ok "Installed: $name Nerd Font"
    else
        ok "Files copied to $dir"
        warn "fontconfig cannot detect the font yet; open a new terminal and try 'htb icons' again."
    fi

    printf '\n  %sSelect the font in your terminal settings:%s\n' "$BOLD" "$RST"
    printf '   %skitty%s        font_family %s NF\n'        "$CYN" "$RST" "$name"
    printf '   %salacritty%s    font.normal.family: "%s Nerd Font"\n' "$CYN" "$RST" "$name"
    printf '   %swezterm%s      font = wezterm.font("%s Nerd Font")\n' "$CYN" "$RST" "$name"
    printf '   %sGNOME/Konsole%s  profile settings -> custom font\n\n' "$CYN" "$RST"
}

cmd_icons() {
    printf '  Current icon set: %s%s%s   (override with HTB_ICONS=nerd|emoji|ascii)\n' "$BOLD$CYN" "$ICONSET" "$RST"
    if [ "$ICONSET" != nerd ]; then
        printf '  %sFor fancy icons:%s htb font%s\n' "$GRY" "$YEL" "$RST"
    fi
    echo
    printf '  %s %s %s %s %s   operating systems\n' "$(os_icon windows)" "$(os_icon linux)" \
        "$(os_icon freebsd)" "$(os_icon macos)" "$(os_icon other)"
    printf '  %s %s   own / not owned\n' "$(own_fmt true)" "$(own_fmt false)"
    printf '  %s %s   blood / no blood\n' "$(blood_fmt true)" "$(blood_fmt false)"
    printf '  %s %s %s %s   status messages\n' "$GRN$I_OK$RST" "$RED$I_NO$RST" "$YEL$I_WARN$RST" "$BLU$I_INFO$RST"
    printf '  %s %s %s %s   difficulty\n' "$(diff_fmt Easy)" "$(diff_fmt Medium)" \
        "$(diff_fmt Hard)" "$(diff_fmt Insane)"
    echo
}

cmd_version() { printf 'htb %s%s%s  %s(icons: %s)%s\n' "$BOLD$GRN" "$HTB_VERSION" "$RST" "$GRY" "$ICONSET" "$RST"; }

usage() {
    _banner
    printf '\n  %s%shtb%s %s%s%s  %s- HackTheBox client%s\n' \
        "$BOLD" "$GRN" "$RST" "$GRY" "$HTB_VERSION" "$RST" "$GRY" "$RST"
    printf '  %sUsage: htb <command> [arguments]%s\n\n' "$GRY" "$RST"
    local rows=(
    "whoami\tDisplay account information and validate the token"
    "list [N]\tList the latest N machines (default: 15)"
    "latest\tDisplay the most recently released machine"
    "season\tList machines in the active season"
    "info <name|id>\tDisplay machine information"
    "active\tShow the currently spawned machine and its IP"
    "spawn <name|id>\tSpawn a machine and wait for its IP"
    "ip [name|id]\tWait for and display the active machine's IP"
    "host [dom1 dom2 ...]\tAdd the active IP and domains to /etc/hosts"
    "stop [name|id]\tStop a machine (active machine by default)"
    "reset [name|id]\tReset a machine"
    "own <flag> [diff]\tSubmit a flag for the active machine"
    "own <machine> <flag>\tSubmit a flag for a specific machine"
    "vpn [product]\tDownload a VPN profile (labs, sp, fortress, arena, prolab...)"
    "vpns\tList local VPN profiles"
    "connect [profile]\tConnect to a VPN (interactive menu if omitted)"
    "disconnect\tDisconnect only VPNs launched by htb"
    "vpnstatus\tShow VPN connection status and active profile"
    "icons\tDisplay the detected icon set"
    "font [Hack]\tInstall a Nerd Font (Arch/Debian/Fedora/macOS)"
    "version\tDisplay the htb version"
    )
    local row cmd desc
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r cmd desc <<< "$(printf '%b' "$row")"
        printf '    '
        cell "$BOLD$WHT$cmd$RST" 22
        printf '  %s%s%s\n' "$GRY" "$desc" "$RST"
    done
    printf '\n  %sFirst blood:%s  htb spawn X  ->  htb own <user>  ->  htb own <root>\n' "$YEL" "$RST"
    printf '  %sAppearance:%s   HTB_ICONS=nerd|emoji|ascii   NO_COLOR=1\n\n' "$GRY" "$RST"
}

# ================= Dispatch =================
cmd="$1"; shift 2>/dev/null
case "$cmd" in
    whoami)        cmd_whoami "$@" ;;
    list|ls)       cmd_list "$@" ;;
    latest|new)    cmd_latest "$@" ;;
    season)        cmd_season "$@" ;;
    info)          cmd_info "$@" ;;
    active)        cmd_active "$@" ;;
    spawn|deploy)  cmd_spawn "$@" ;;
    ip)            cmd_ip "$@" ;;
    host|hosts)      cmd_host "$@" ;;
    stop|kill|terminate) cmd_stop "$@" ;;
    reset)         cmd_reset "$@" ;;
    own|flag|submit) cmd_own "$@" ;;
    vpn)           cmd_vpn "$@" ;;
    vpns|profiles) cmd_vpns "$@" ;;
    connect)       cmd_connect "$@" ;;
    disconnect|dc) cmd_disconnect "$@" ;;
    vpnstatus)     cmd_vpnstatus "$@" ;;
    icons)         cmd_icons ;;
    font|setup-font) cmd_font "$@" ;;
    version|--version|-V) cmd_version ;;
    ""|-h|--help|help) usage ;;
    *) bad "Unknown command: $cmd"; usage; exit 1 ;;
esac
